# 复制为 .env.local（本地开发）或 /opt/zigoai/.env（服务器），填入真实值。
# 再次强调：.env* 已被 .gitignore 覆盖，绝不要提交任何密钥。

# ---------- 数据库 ----------
DATABASE_URL="postgresql://zigoai:zigoai@127.0.0.1:5432/zigoai"

# ---------- DeepSeek ----------
DEEPSEEK_API_KEY="sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
DEEPSEEK_BASE_URL="https://api.deepseek.com"
# 实测可用：deepseek-flash（快、便宜，已验证 json_object）、deepseek-v4-pro（更强）
DEEPSEEK_MODEL="deepseek-flash"
DEEPSEEK_MODEL_PRO="deepseek-v4-pro"
DEEPSEEK_TIMEOUT_MS="20000"
# 成本统计单价（元 / 百万 token）。Step 0 按官方价目表核对后填入。
DEEPSEEK_PRICE_IN_PER_MTOK="0"
DEEPSEEK_PRICE_OUT_PER_MTOK="0"

# ---------- 会话 ----------
# 32 位以上随机字符串，用于签名 session cookie
SESSION_SECRET="please-generate-a-32-char-random-secret"

# ---------- 运维接口 ----------
# 演示数据重置接口 POST /api/admin/reset 的口令；留空则接口关闭（生产建议留空）
SEED_TOKEN=""

# ---------- 业务可调参数（演示用短窗口/短阈值） ----------
# 连续消息聚合窗口：窗口内的多条客户消息算「一轮沟通」，只调一次 AI。
# 这是**单条陈述**时的窗口（客户只是随口说一句，宁可多等也别抢答）
MESSAGE_BATCH_WINDOW_MS="8000"
# 「客户在等答案」时的短窗口：客户最后一句是问句/明确诉求时用它（客户问了问题，销售不该干等 8 秒）。
# 窗口分三档：问句=本值，连发补充=本值×1.5，单条陈述=MESSAGE_BATCH_WINDOW_MS。
# 把本值设成与 MESSAGE_BATCH_WINDOW_MS 相同，即退回旧的"固定窗口"行为。
MESSAGE_BATCH_FAST_WINDOW_MS="2000"
# Follow-up：客户静默超过该分钟数即视为需要跟进
FOLLOWUP_IDLE_MINUTES="2"
# Follow-up 最大跟进次数（防止无限打扰）
FOLLOWUP_MAX_ATTEMPTS="2"
